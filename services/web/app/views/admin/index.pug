extends ../layout-react

block entrypointVar
	- entrypoint = 'pages/admin'

block vars
	- isWebsiteRedesign = true

block append meta
	meta(name='ol-user' data-type='json' content=user)
	meta(
		name='ol-serverAdmin'
		data-type='json'
		content={
			systemMessages,
			openSockets,
			editorIsOpen: !!settings.editorIsOpen,
		}
	)

block content
	main#main-content.content.content-alt(tabindex='-1')
		#server-admin-root
