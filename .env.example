# Optional: copy to .env before starting. Defaults work at http://localhost:8080.
COMPOSE_PROJECT_NAME=overleaf
OVERLEAF_BIND_ADDRESS=127.0.0.1
OVERLEAF_PORT=8080
OVERLEAF_SITE_URL=http://localhost:8080
OVERLEAF_APP_NAME=Overleaf
OVERLEAF_NAV_TITLE=Overleaf
# Public source repository shown in Account > Source code.
OVERLEAF_SOURCE_URL=https://github.com/cerulean-works/overleaf

# Keep these aligned with the image and the versioned TeX volume.
OVERLEAF_PLATFORM=linux/amd64
TEXLIVE_RELEASE=2026
TEXLIVE_ARCH=x86_64-linux
TEXLIVE_BASELINE=basic-v1
# Use a matching historic tlnet-final mirror after the rolling mirror moves on.
# TEXLIVE_MIRROR=https://mirror.ox.ac.uk/sites/ctan.org/systems/texlive/tlnet

# Optional for fresh installations: both keys are generated in the app volume.
# Existing deployments MUST retain their original value during migration.
# OVERLEAF_INVITE_TOKEN_SECRET=your-existing-persistent-key
# OVERLEAF_SESSION_SECRET=your-existing-session-key

# SMTP is optional. Without SMTP, admins can copy activation links manually.
# OVERLEAF_EMAIL_FROM_ADDRESS=overleaf@example.com
# OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_SECURE=false
# OVERLEAF_EMAIL_SMTP_USER=
# OVERLEAF_EMAIL_SMTP_PASS=

# HTTPS reverse proxy: set the public site URL above and uncomment below.
# This flag is presence-based: omit it entirely for local HTTP.
# OVERLEAF_SECURE_COOKIE=true
# Include loopback for the nginx instance inside the app container.
# OVERLEAF_TRUSTED_PROXY_IPS=loopback,172.20.0.0/16
